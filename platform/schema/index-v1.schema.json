{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signed successor platform index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "signed",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "signed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "channel",
        "sequence",
        "generated_at",
        "expires_at",
        "artifacts"
      ],
      "properties": {
        "repository_id": {
          "const": "official-platform"
        },
        "channel": {
          "enum": [
            "stable",
            "beta",
            "dev"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    },
    "signature": {
      "$ref": "#/$defs/signature"
    }
  },
  "$defs": {
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "identity",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "arch",
        "abi"
      ],
      "properties": {
        "os": {
          "const": "linux"
        },
        "arch": {
          "enum": [
            "amd64",
            "arm64",
            "any"
          ]
        },
        "abi": {
          "enum": [
            "static",
            "glibc",
            "musl",
            "pure"
          ]
        },
        "min_kernel": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "sha256",
        "size",
        "signature"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^platform/packages/[A-Za-z0-9._/-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "signature": {
          "$ref": "#/$defs/signature"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "version_range"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "module"
              }
            },
            "required": ["kind"]
          },
          "then": {
            "required": ["portable_config"]
          },
          "else": {
            "not": {
              "required": ["portable_config"]
            }
          }
        }
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]+$"
        },
        "version_range": {
          "type": "string",
          "minLength": 1
        },
        "optional": {
          "type": "boolean"
        }
      }
    },
    "portable_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "current_settings_schema",
        "accepted_source_schemas"
      ],
      "properties": {
        "protocol": {
          "const": 1
        },
        "current_settings_schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
        },
        "accepted_source_schemas": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "kind",
        "version",
        "build",
        "platform",
        "requires_scaffold_api",
        "dependencies",
        "package"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]+$"
        },
        "kind": {
          "enum": [
            "scaffold-manager",
            "runtime",
            "module"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "build": {
          "type": "integer",
          "minimum": 1
        },
        "platform": {
          "$ref": "#/$defs/platform"
        },
        "requires_scaffold_api": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimum",
            "maximum_exclusive"
          ],
          "properties": {
            "minimum": {
              "type": "integer",
              "minimum": 1
            },
            "maximum_exclusive": {
              "type": "integer",
              "minimum": 2
            }
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "portable_config": {
          "$ref": "#/$defs/portable_config"
        },
        "package": {
          "$ref": "#/$defs/package"
        }
      }
    }
  }
}
