{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only immutable successor release candidate manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "artifact_class",
    "channel",
    "sequence",
    "sources",
    "handoff_digest",
    "images",
    "package_closure"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "artifact_class": {
      "const": "successor-qualified-release-candidate"
    },
    "channel": {
      "const": "stable"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core",
        "modules",
        "python"
      ],
      "properties": {
        "core": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "modules": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "python": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "handoff_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full",
        "supervisor"
      ],
      "properties": {
        "full": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "digest",
            "catalog_sha256"
          ],
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "catalog_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "supervisor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "digest",
            "catalogs_sha256"
          ],
          "properties": {
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "catalogs_sha256": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amd64",
                "arm64"
              ],
              "properties": {
                "amd64": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "arm64": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "package_closure": {
      "type": "array",
      "minItems": 3,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "version",
          "build",
          "platform",
          "url",
          "sha256",
          "size"
        ],
        "properties": {
          "artifact_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]+$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "build": {
            "type": "integer",
            "minimum": 1
          },
          "platform": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "os",
              "arch",
              "abi"
            ],
            "properties": {
              "os": {
                "const": "linux"
              },
              "arch": {
                "enum": [
                  "amd64",
                  "arm64",
                  "any"
                ]
              },
              "abi": {
                "enum": [
                  "static",
                  "glibc",
                  "musl",
                  "pure"
                ]
              }
            }
          },
          "url": {
            "type": "string",
            "pattern": "^platform/packages/[A-Za-z0-9][A-Za-z0-9._-]{0,180}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
